    <technology>
      <technologyDescriptionAndIncludedProcesses xml:lang="en">Passenger car with variable parameters: driving share urban/interurban/motorway and total mileage over lifetime. Inputs: electricity, vehicle (production), road. Outputs: driving distance, vehicle (end-of-life).									&#13;
For more information please refer to: https://scn.spherasolutions.com/client/downloads.aspx?product=GaBi&amp;productID=47</technologyDescriptionAndIncludedProcesses>
      <technologicalApplicability xml:lang="en">Provision of a standard transport service according to the applied technology.</technologicalApplicability>
      <referenceToTechnologyFlowDiagrammOrPicture refObjectId="66258927-5dcb-445e-9f6d-a79469322e20" type="source data set" uri="../sources/66258927-5dcb-445e-9f6d-a79469322e20.xml" version="30.00.000">
        <common:shortDescription xml:lang="en">transport_car.jpg</common:shortDescription>
      </referenceToTechnologyFlowDiagrammOrPicture>
    </technology>
    <mathematicalRelations>
      <modelDescription xml:lang="en">The open parameters in this processes enable the user to adjust the model to their individual circumstances. The description of the parameters is given alongside the parameters in the comments section.&#13;
&#13;
For mathematical model details concerning the implementation of the CCF formula see: &#13;
http://www.gabi-software.com/fileadmin/GaBi_Databases/PEF_CFF_model_description.pdf</modelDescription>
      <variableParameter name="driving_perform">
        <meanValue>150000.0</meanValue>
        <relativeStandardDeviation95In>0.000</relativeStandardDeviation95In>
        <comment xml:lang="en">[km] Life-time mileage of vehicle</comment>
      </variableParameter>
      <variableParameter name="driving_share">
        <formula>1 / (driving_perform)</formula>
        <meanValue>6.66666666666667E-6</meanValue>
        <relativeStandardDeviation95In>0.000</relativeStandardDeviation95In>
        <comment xml:lang="en">[1/km] Reciprocal of mileage</comment>
      </variableParameter>
      <variableParameter name="road">
        <formula>(spec_elec_tot/43.1/53800000000)*(690000/50)*1000</formula>
        <meanValue>7.40710190980043E-6</meanValue>
        <relativeStandardDeviation95In>0.000</relativeStandardDeviation95In>
        <comment xml:lang="en">[m] meters of average street allocated to the vehicle km (average of diesel, petrol, CNG)</comment>
      </variableParameter>
      <variableParameter name="service_life">
        <meanValue>150000.0</meanValue>
        <relativeStandardDeviation95In>0.000</relativeStandardDeviation95In>
        <comment xml:lang="en">[km] service life of the car (default 150000km)</comment>
      </variableParameter>
      <variableParameter name="share_check">
        <formula>share_mw + share_ru + share_ur</formula>
        <meanValue>1.0</meanValue>
        <relativeStandardDeviation95In>0.000</relativeStandardDeviation95In>
        <comment xml:lang="en">Result must be 1!</comment>
      </variableParameter>
      <variableParameter name="share_mw">
        <meanValue>0.3</meanValue>
        <minimumValue>0.0</minimumValue>
        <maximumValue>1.0</maximumValue>
        <relativeStandardDeviation95In>0.000</relativeStandardDeviation95In>
        <comment xml:lang="en">[-] Percentage on motorway, Standard = 0,3</comment>
      </variableParameter>
      <variableParameter name="share_ru">
        <meanValue>0.39</meanValue>
        <minimumValue>0.0</minimumValue>
        <maximumValue>1.0</maximumValue>
        <relativeStandardDeviation95In>0.000</relativeStandardDeviation95In>
        <comment xml:lang="en">[-] Percentage outside of town, Standard = 0,39</comment>
      </variableParameter>
      <variableParameter name="share_ur">
        <meanValue>0.31</meanValue>
        <minimumValue>0.0</minimumValue>
        <maximumValue>1.0</maximumValue>
        <relativeStandardDeviation95In>0.000</relativeStandardDeviation95In>
        <comment xml:lang="en">[-] Percentage within  town, Standard = 0,31</comment>
      </variableParameter>
      <variableParameter name="spec_elec_mw">
        <formula>(1.73554623126984)</formula>
        <meanValue>1.73554623126984</meanValue>
        <relativeStandardDeviation95In>0.000</relativeStandardDeviation95In>
        <comment xml:lang="en">[MJ/km] electric consumption motorway</comment>
      </variableParameter>
      <variableParameter name="spec_elec_ru">
        <formula>(1.07668018341064)</formula>
        <meanValue>1.07668018341064</meanValue>
        <relativeStandardDeviation95In>0.000</relativeStandardDeviation95In>
        <comment xml:lang="en">[MJ/km] electric consumption outside of town</comment>
      </variableParameter>
      <variableParameter name="spec_elec_tot">
        <formula>((share_mw * spec_elec_mw) + (share_ru * spec_elec_ru) + (share_ur * spec_elec_ur))</formula>
        <meanValue>1.24459708452225</meanValue>
        <relativeStandardDeviation95In>0.000</relativeStandardDeviation95In>
        <comment xml:lang="en">[MJ/km] electric consumption weighted</comment>
      </variableParameter>
      <variableParameter name="spec_elec_ur">
        <formula>(0.980735301971436)</formula>
        <meanValue>0.980735301971436</meanValue>
        <relativeStandardDeviation95In>0.000</relativeStandardDeviation95In>
        <comment xml:lang="en">[MJ/km] electric consumption within a town</comment>
      </variableParameter>
    </mathematicalRelations>
