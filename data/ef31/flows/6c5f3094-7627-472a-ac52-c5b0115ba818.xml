      <common:generalComment xml:lang="en">The data set represents the applied technology with a good overall data quality. The inventory is based on industry and literature data.									&#13;
								&#13;
- source driving share: HBEFA 4.1, status Oktober 2019									&#13;
- input parameter: driving performance [km], driving share motorway/rural/urban</common:generalComment>
    </dataSetInformation>
    <quantitativeReference type="Reference flow(s)">
      <referenceToReferenceFlow>4</referenceToReferenceFlow>
    </quantitativeReference>
