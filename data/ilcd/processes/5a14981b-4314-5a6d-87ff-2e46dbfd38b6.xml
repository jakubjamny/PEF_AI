            <name>
                <baseName>spinning, for woven, open end (rotor) (170 dtex-153 denier-34/1 ne-59 nm), elementary</baseName>
                <treatmentStandardsRoutes>spinning process</treatmentStandardsRoutes>
                <mixAndLocationTypes>production mix</mixAndLocationTypes>
                <functionalUnitFlowProperties>service of spinning 1kg of yarn (raw material excluded)</functionalUnitFlowProperties>
            </name>
            <identifierOfSubDataSet/>
