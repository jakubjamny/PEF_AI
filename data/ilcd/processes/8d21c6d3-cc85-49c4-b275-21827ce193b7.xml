  <processInformation>
    <dataSetInformation>
      <common:UUID>8d21c6d3-cc85-49c4-b275-21827ce193b7</common:UUID>
      <name>
        <baseName xml:lang="en">Conversion from electricity medium voltage to electricity low voltage</baseName>
        <treatmentStandardsRoutes xml:lang="en">Transformation of medium voltage electricity to low voltage</treatmentStandardsRoutes>
        <mixAndLocationTypes xml:lang="en">Consumption mix, to consumer</mixAndLocationTypes>
        <functionalUnitFlowProperties xml:lang="en">grid losses, from 0,54% to 18,18% see general comments</functionalUnitFlowProperties>
      </name>
      <classificationInformation>
        <common:classification>
          <common:class level="0">Energy carriers and technologies</common:class>
          <common:class level="1">Electricity</common:class>
        </common:classification>
      </classificationInformation>
      <common:generalComment xml:lang="en">
&#13;
This process corresponds to the losses occuring during the transport in the medium voltage network and transformation into low voltage&#13;
Typical values are for Europe between 0,61% and 4,32% with an average of 2,29%. For World these values are between 0,54% and 18,18% with an average of 4,10%. For exact values for European countries please see table below. These values may be used in specific country scopes.</common:generalComment>
    </dataSetInformation>
    <quantitativeReference type="Reference flow(s)">
      <referenceToReferenceFlow>1</referenceToReferenceFlow>
    </quantitativeReference>
    <time>
      <common:referenceYear>2012</common:referenceYear>
      <common:dataSetValidUntil>2024</common:dataSetValidUntil>
      <common:timeRepresentativenessDescription xml:lang="en">Annual average, the most recent data source consistently available for all countries (IEA for 2012) has been used. The DQR of the dataset reflects the quality of the data at the time of release. The user of the dataset should revise the DQR at the moment of application.</common:timeRepresentativenessDescription>
    </time>
    <geography>
      <locationOfOperationSupplyOrProduction location="GLO">
        <descriptionOfRestrictions xml:lang="en">The data set represents the global average. Main technologies for electricity transformation from medium to low voltage are considered according to the global situation.The geographical representativeness concerning the related country as well as its DQR is related to relevance of the contributors. Possible geographical variance of minor contributors below the cut-off criteria are not affecting the geographical representativeness of the overall process, but are positively affecting the completeness of the model.</descriptionOfRestrictions>
      </locationOfOperationSupplyOrProduction>
    </geography>
    <technology>
      <technologyDescriptionAndIncludedProcesses xml:lang="en">This process corresponds to the losses due to the transformation from medium voltage to low voltage.</technologyDescriptionAndIncludedProcesses>
      <technologicalApplicability xml:lang="en">This dataset has to be used to model losses due to the transformation from medium voltage to low voltage electricity.</technologicalApplicability>
      <referenceToTechnologyPictogramme refObjectId="6650c079-1619-412b-9552-70e0e8513b41" type="source data set" uri="../sources/6650c079-1619-412b-9552-70e0e8513b41.xml" version="30.00.000">
        <common:shortDescription xml:lang="en">electricity network losses.JPG</common:shortDescription>
      </referenceToTechnologyPictogramme>
    </technology>
    <mathematicalRelations>
      <modelDescription xml:lang="en">For mathematical model details concerning the implementation of the CCF formula see: &#13;
http://www.gabi-software.com/fileadmin/GaBi_Databases/PEF_CFF_model_description.pdf</modelDescription>
      <variableParameter name="input">
        <formula>1 + (losses / 100)</formula>
        <meanValue>1.0229</meanValue>
        <relativeStandardDeviation95In>0</relativeStandardDeviation95In>
      </variableParameter>
      <variableParameter name="losses">
        <meanValue>2.29</meanValue>
        <minimumValue>0.0</minimumValue>
        <maximumValue>100.0</maximumValue>
        <relativeStandardDeviation95In>0</relativeStandardDeviation95In>
        <comment xml:lang="en">[%] Losses occuring during the transport in the medium voltage net and transformation into low volta</comment>
      </variableParameter>
    </mathematicalRelations>
