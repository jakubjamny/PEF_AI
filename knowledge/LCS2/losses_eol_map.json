{
  "version": "PEFCR_A&F_v3.1",
  "notes": [
    "EoL for manufacturing losses/leftovers in LCS2 follows the product EoL for apparel.",
    "Default apparel recycling (R2) from PEFCR Table 22 ≈ 17% total → 5% wipers + 12% insulation; the rest to MSW.",
    "MSW split is NORMALISED within MSW (exclude recycling/composting). EU27_2020 uses 27% incineration and 23% landfill ⇒ incineration_share=0.54, landfill_share=0.46 (Eurostat 2020).",
    "Packaging EoL (e.g., LDPE shrink film, cardboard) is handled separately via Table 28 and should not be mapped here."
  ],

  "apparel_default_shares": {
    "recycling_wipers": 0.05,
    "recycling_insulation": 0.12,
    "msw_rest": 0.83
  },

  "footwear_default_shares": {
    "recycling_wipers": 0.0,
    "recycling_insulation": 0.0,
    "msw_rest": 1.0
  },

  "msw_split": {
    "source": "Eurostat 2020 (EU-27); normalised within MSW",
    "incineration_share": 0.54,
    "landfill_share": 0.46
  },

  "msw_split_overrides": {
    "notes": "Optional region/country overrides. Values are NORMALISED within MSW and must sum to 1.",
    "EU27_2020": { "incineration_share": 0.54, "landfill_share": 0.46 },
    "EU27_2019": { "incineration_share": null, "landfill_share": null },
    "CZ":       { "incineration_share": null, "landfill_share": null },
